<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system splash. Only the center 192dp of the 288dp icon
      slot is drawn, so the default (the adaptive launcher icon) was a
      cropped, oversized emblem. splash_icon keeps the whole badge inside
      that circle at ~100dp. The background is the brand emerald; the icon's
      transparent padding shows it. The window background stays the
      full-bleed splash bitmap so the smaller centered emblem remains while
      the WebView loads.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
