# Phase 1 frontend env (safe to commit, no secrets)
# Copy to .env.local and adjust per environment.

# Mock backend for Phase 1 (server/mock-server.js). Set to empty string
# to fall back to a real backend or to a same-origin deployment.
VITE_API_BASE_URL=http://localhost:8787
VITE_USE_MOCK_BACKEND=1

# Phase 4 (AdMob) — placeholder. Real Android values arrive in Phase 4.
VITE_ADMOB_BANNER_UNIT_ID=

# Phase 3 (Google Sign-In) — placeholder. Web OAuth client ID arrives
# after Phase 0 step §0.4.
VITE_GOOGLE_WEB_CLIENT_ID=

# Firebase Web SDK (auth). Public client config — the apiKey is embedded in
# every client that talks to Firebase and is NOT a secret. The trust
# boundary is Firestore Security Rules + server-side ID token verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Mock server flags (server-side, NOT prefixed with VITE_).
# MOCK_PORT=8787
# VITE_MOCK_PREMIUM=0   # 1 = server returns premium entitlement on boot
