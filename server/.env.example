# Phase 2 backend — local dev

# Server bind
PORT=8788

# Firebase. Production project is mahjong-sc-2377a (not savetheday-2377a).
FIREBASE_PROJECT_ID=mahjong-sc-2377a
# Leave unset to use ADC: `gcloud auth application-default login`
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase emulators (uncomment for local dev)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Vision provider (Phase 2)
VISION_PROVIDER=minimax           # minimax | disabled
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_VISION_MODEL=MiniMax-M3

# Quota
# Lifetime purchases are unlimited and do not use AI_LIFETIME_QUOTA.
# Free camera scans reset at 00:00 Asia/Hong_Kong.
AI_MONTHLY_QUOTA=200
AI_FREE_DAILY_SCANS=3
AI_SCANS_PER_AD=5
AI_MAX_REWARDED_ADS_PER_DAY=3

# Rewarded ads. SSV is verified with Google's public keys (no shared secret).
# Test ads do NOT call the SSV endpoint. Set this to 1 on a non-production
# server so a device build can credit +5 scans after a test video.
# Ignored when NODE_ENV=production.
# ADMOB_REWARD_DEV_MODE=1
# ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Google Play Developer API (Phase 3)
GOOGLE_PLAY_PACKAGE_NAME=
# base64 of GCP service-account JSON with androidpublisher permission
GOOGLE_PLAY_SA_KEY=

# Logging
LOG_LEVEL=info
