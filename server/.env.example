# Phase 2 backend — local dev

# Server bind
PORT=8788

# Firebase
FIREBASE_PROJECT_ID=mahjong-prod-xxx
# Leave unset to use ADC: `gcloud auth application-default login`
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase emulators (uncomment for local dev)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Vision provider (Phase 2)
VISION_PROVIDER=minimax           # minimax | disabled
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_VISION_MODEL=MiniMax-M3

# Quota
AI_MONTHLY_QUOTA=200

# Google Play Developer API (Phase 3)
GOOGLE_PLAY_PACKAGE_NAME=
# base64 of GCP service-account JSON with androidpublisher permission
GOOGLE_PLAY_SA_KEY=

# Logging
LOG_LEVEL=info
