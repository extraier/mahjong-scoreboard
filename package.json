{
  "name": "mahjong-scoreboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node server/mock-server.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:open:android": "cap open android",
    "deploy": "vercel --prod",
    "start:server": "node --import tsx server/src/index.ts",
    "build:android": "VITE_API_BASE_URL=https://mahjong-scoreboard-nine.vercel.app npm run build",
    "cap:sync:android": "npm run build:android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "capacitor-plugin-cdv-purchase": "^13.19.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.0.1",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.6",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
